# KhataDost backend settings. Copy to backend/.env and fill in the values.
# backend/.env is gitignored: never commit real secrets, and never put the
# Gemini key anywhere in the Flutter app.
#
# Used two ways:
#   docker compose up    reads this file for JWT_SECRET, ACCESS_CODE and
#                        GEMINI_API_KEY (compose sets DATABASE_URL and PORT itself)
#   go run ./cmd/api     reads every value below

# Postgres. This points at the Docker database from your Mac (port 5433).
# For your own local Postgres, change the user, password, port and name.
# Special characters in a password must be URL-encoded (@ becomes %40).
DATABASE_URL=postgres://khatadost:khatadost@127.0.0.1:5433/khatadost?sslmode=disable

# Signs the login tokens. Use a long random string, for example the output
# of: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Shops must type this code to register. Pick your own.
ACCESS_CODE=REPLACE_WITH_YOUR_ACCESS_CODE

# Port the API listens on (default 8080).
PORT=8080

# Google AI Studio key for camera scan. Leave empty to run without scan
# (everything else works; /v1/scan answers 502).
GEMINI_API_KEY=
